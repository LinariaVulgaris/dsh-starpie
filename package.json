{
  "name": "@local/dsh-starpie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StarPie: a right-click radial menu for the DSH Web GUI, configured from the StarPie section of the settings panel (actions, order, ring size, liquid-glass tuning with live preview, motion, theme color).",
  "license": "MIT",
  "author": "LinariaVulgaris",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "radial-menu",
    "context-menu",
    "starpie"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinariaVulgaris/dsh-starpie.git"
  },
  "homepage": "https://github.com/LinariaVulgaris/dsh-starpie#readme",
  "bugs": {
    "url": "https://github.com/LinariaVulgaris/dsh-starpie/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
